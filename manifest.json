{
  "manifest_version": 3,
  "name": "Triagem extensão",
  "version": "1.0",
  "description": "Pra facilitar a vida na triagem. © by miguel b. ©",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.mgraneis.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "css": ["style.css"],
      "matches": ["https://www.mgraneis.com.br/*"],
      "js": ["content.js"],
      "type": "module"
    }
  ]
}
